# MedDefense custom Suricata rules

alert tcp 10.10.4.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE POLICY Medical Device TCP to Internet"; flow:to_server; classtype:policy-violation; sid:9000001; rev:1;)

alert udp 10.10.4.0/24 any -> !$HOME_NET !123 (msg:"MEDDEFENSE POLICY Medical Device UDP to Internet Non-NTP"; classtype:policy-violation; sid:9000007; rev:1;)

alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"MEDDEFENSE POLICY Unauthorized Guest SMB to Internal Network"; flow:to_server; flags:S; classtype:attempted-admin; sid:9000002; rev:1;)

alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE EXFIL Large Outbound TCP From Server Over 50MB in 300s"; flow:to_server,established; flow.age:<=300; stream_size:client,>,52428800; threshold:type limit, track by_both, count 1, seconds 300; classtype:policy-violation; sid:9000003; rev:1;)

alert dns $HOME_NET any -> any 53 (msg:"MEDDEFENSE DNS Tunneling Leftmost Label Over 50 Characters"; dns.query; pcre:"/^[^.]{51,}\./"; classtype:bad-unknown; sid:9000004; rev:1;)

alert tcp 10.10.2.0/24 any -> !10.10.1.50 3306 (msg:"MEDDEFENSE POLICY Clinical Workstation to Unauthorized Database"; flow:to_server; flags:S; classtype:policy-violation; sid:9000005; rev:1;)

alert tcp any any -> 10.10.4.0/24 23 (msg:"MEDDEFENSE POLICY Cleartext Telnet to Medical Device"; flow:to_server; flags:S; classtype:policy-violation; sid:9000006; rev:1;)
